    "definitions": {
        "model.LoginRequest": {
            "type": "object",
            "required": [
                "password",
                "username"
            ],
            "properties": {
                "password": {
                    "type": "string",
                    "minLength": 6,
                    "example": "password"
                },
                "username": {
                    "type": "string",
                    "minLength": 2,
                    "example": "user1"
                }
            }
        },
        "model.ReservationRequest": {
            "type": "object",
            "properties": {
                "bookingDate": {
                    "type": "string",
                    "example": "2025-02-01"
                },
                "company": {
                    "type": "string",
                    "example": "ABC Company"
                },
                "endTime": {
                    "type": "string",
                    "example": "09:00"
                },
                "name": {
                    "type": "string",
                    "example": "John Doe"
                },
                "notes": {
                    "type": "string",
                    "example": "Additional notes"
                },
                "participants": {
                    "type": "integer",
                    "example": 10
                },
                "phone": {
                    "type": "string",
                    "example": "1234567890"
                },
                "roomId": {
                    "type": "integer",
                    "example": 2
                },
                "snackId": {
                    "type": "integer",
                    "example": 1
                },
                "startTime": {
                    "type": "string",
                    "example": "08:00"
                },
                "userId": {
                    "type": "integer",
                    "example": 1
                }
            }
        },
        "model.RoomRequest": {
            "type": "object",
            "required": [
                "capacity",
                "name",
                "price",
                "room_type"
            ],
            "properties": {
                "capacity": {
                    "type": "integer",
                    "minimum": 1,
                    "example": 20
                },
                "id": {
                    "type": "integer"
                },
                "imgUrl": {
                    "type": "string",
                    "example": "https://example.com/image.jpg"
                },
                "name": {
                    "type": "string",
                    "minLength": 2,
                    "example": "Aster Room"
                },
                "price": {
                    "type": "integer",
                    "minimum": 1,
                    "example": 10000
                },
                "room_type": {
                    "type": "integer",
                    "minimum": 1,
                    "example": 1
                }
            }
        },
        "model.UpdateUserRequest": {
            "type": "object",
            "properties": {
                "imgUrl": {
                    "type": "string",
                    "example": "https://example.com/image.jpg"
                },
                "isActive": {
                    "type": "boolean",
                    "example": true
                },
                "password": {
                    "type": "string",
                    "minLength": 6,
                    "example": "password"
                }
            }
        },
        "model.UserRequest": {
            "type": "object",
